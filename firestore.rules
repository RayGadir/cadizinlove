rules_version = '2';

// Reglas de la colección "members" de Cádiz in Love.
//
// - Cualquiera puede crear su PROPIA ficha al registrarse, pero solo con
//   role: "pendiente" — no puede auto-asignarse director/admin.
// - Cualquiera puede leer su propia ficha (para ver si ya le han aprobado).
// - Solo un director o administrador puede leer la lista completa de
//   componentes, y solo un director o administrador puede modificar
//   cualquier ficha (aprobar, rechazar, asignar voz, nombrar director).
// - Un director o administrador puede eliminar una ficha (por ejemplo para
//   quitar a alguien del coro); nadie puede borrar la suya propia.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Una sola lectura del propio documento, reutilizada por myRole() y
    // myVoices() — antes cada una hacía su propio get(), duplicando la
    // lectura en cada evaluación de regla de /ensayo y /orquesta.
    function myMember() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function myRole() {
      return myMember().role;
    }

    function isDirectorOrAdmin() {
      return isSignedIn() && myRole() in ['director', 'admin'];
    }

    match /members/{memberId} {
      allow get: if isSignedIn() && (request.auth.uid == memberId || isDirectorOrAdmin());
      allow list: if isDirectorOrAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == memberId
        && request.resource.data.role == 'pendiente';

      allow update: if isDirectorOrAdmin();

      allow delete: if isDirectorOrAdmin() && request.auth.uid != memberId;
    }

    match /songs/{songId} {
      allow read: if isSignedIn();
      allow write: if isDirectorOrAdmin();
    }

    // Local del Ensayo y Orquesta: filtrar por voz aquí (con get() sobre el
    // propio documento) se probó poco fiable — Firestore rechaza consultas
    // "list" enteras con permission-denied cuando la regla depende de un
    // valor obtenido con get() en vez de un literal, incluso cuando el dato
    // real cumpliría la condición (pasó con varias coristas). Los archivos
    // de Storage ya son legibles por cualquier sesión iniciada (URL con
    // token inadivinable, ver storage.rules), así que el filtro por voz
    // real solo lo aplica la propia app al consultar/mostrar — aquí basta
    // con exigir sesión iniciada para leer los metadatos.
    match /ensayo/{audioId} {
      allow read: if isSignedIn();
      allow write: if isDirectorOrAdmin();
    }

    match /orquesta/{itemId} {
      allow read: if isSignedIn();
      allow write: if isDirectorOrAdmin();
    }

    match /avisos/{avisoId} {
      allow read: if isSignedIn();
      allow write: if isDirectorOrAdmin();
    }
  }
}
