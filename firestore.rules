rules_version = '2';

// Reglas de la colección "members" de Cádiz in Love.
//
// - Cualquiera puede crear su PROPIA ficha al registrarse, pero solo con
//   role: "pendiente" — no puede auto-asignarse director/admin.
// - Cualquiera puede leer su propia ficha (para ver si ya le han aprobado).
// - Solo un director o administrador puede leer la lista completa de
//   componentes, y solo un director o administrador puede modificar
//   cualquier ficha (aprobar, rechazar, asignar voz, nombrar director).
// - Un director o administrador puede eliminar una ficha (por ejemplo para
//   quitar a alguien del coro); cada uno puede borrar la suya propia al
//   eliminar su cuenta.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Una sola lectura del propio documento, reutilizada por myRole() y
    // myVoices() — antes cada una hacía su propio get(), duplicando la
    // lectura en cada evaluación de regla de /ensayo y /orquesta.
    function myMember() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function myRole() {
      return myMember().role;
    }

    function isDirectorOrAdmin() {
      return isSignedIn() && myRole() in ['director', 'admin'];
    }

    // Componente aprobado del coro. Quien se registra entra como
    // "pendiente": solo ve la parte pública (Fotos y, si se activa, el
    // Libreto) — ni el Tablón, ni los audios, ni Ensayo/Orquesta.
    function isApproved() {
      return isSignedIn() && myRole() in ['corista', 'director', 'admin'];
    }

    // Interruptores de la parte pública (config/features), los cambia el
    // admin desde su panel. Si el documento no existe, todo cerrado.
    function features() {
      return exists(/databases/$(database)/documents/config/features)
        ? get(/databases/$(database)/documents/config/features).data
        : {};
    }

    // Estas condiciones solo usan get() sobre documentos fijos (la ficha
    // propia y config/features), sin compararlas con resource.data — así
    // sí funcionan en consultas "list" (ver el comentario de /ensayo).

    match /members/{memberId} {
      allow get: if isSignedIn() && (request.auth.uid == memberId || isDirectorOrAdmin());
      allow list: if isDirectorOrAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == memberId
        && request.resource.data.role == 'pendiente';

      allow update: if isDirectorOrAdmin();

      // Director/admin borran a otros; cada uno puede borrar la suya propia
      // (borrado de cuenta desde Mi perfil).
      allow delete: if (isDirectorOrAdmin() && request.auth.uid != memberId)
        || (isSignedIn() && request.auth.uid == memberId);
    }

    // El Libreto solo lo leen los aprobados, salvo que el admin lo haya
    // abierto al público (libretoPublico) de cara al carnaval.
    match /songs/{songId} {
      allow read: if isApproved() || (isSignedIn() && features().get('libretoPublico', false) == true);
      allow write: if isDirectorOrAdmin();
    }

    // Local del Ensayo y Orquesta: filtrar por voz aquí (con get() sobre el
    // propio documento) se probó poco fiable — Firestore rechaza consultas
    // "list" enteras con permission-denied cuando la regla depende de un
    // valor obtenido con get() en vez de un literal, incluso cuando el dato
    // real cumpliría la condición (pasó con varias coristas). Los archivos
    // de Storage ya son legibles por cualquier sesión iniciada (URL con
    // token inadivinable, ver storage.rules), así que el filtro por voz
    // real solo lo aplica la propia app al consultar/mostrar — aquí basta
    // con exigir sesión iniciada para leer los metadatos.
    match /ensayo/{audioId} {
      allow read: if isApproved();
      allow write: if isDirectorOrAdmin();
    }

    match /orquesta/{itemId} {
      allow read: if isApproved();
      allow write: if isDirectorOrAdmin();
    }

    match /avisos/{avisoId} {
      allow read: if isApproved();
      allow write: if isDirectorOrAdmin();
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isDirectorOrAdmin();
    }

    // Álbum de fotos: lo ve cualquiera con sesión. Suben los aprobados (o
    // cualquiera no rechazado si fotosAbiertoATodos), siempre a su nombre.
    // Borra quien la subió o director/admin.
    match /fotos/{fotoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uploaderUid == request.auth.uid
        && (isApproved()
          || (myRole() == 'pendiente' && features().get('fotosAbiertoATodos', false) == true));
      allow update: if isDirectorOrAdmin();
      allow delete: if isDirectorOrAdmin()
        || (isSignedIn() && resource.data.uploaderUid == request.auth.uid);
    }
  }
}
